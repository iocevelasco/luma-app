# Origen de la web. En el teléfono no uses localhost: es el propio teléfono.
# Simulador iOS: http://localhost:6173
# Emulador Android: http://10.0.2.2:6173
# Teléfono en la misma red: http://<ip-de-esta-maquina>:6173
# Producción: https://<dominio>/app  (la SPA vive bajo /app; la API, en el origen)
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:6173

# Opcional. Si WEB_ORIGIN ya trae el subpath (/app), no hace falta.
# EXPO_PUBLIC_WEB_BASE=/app

# La misma MOBILE_CLIENT_KEY de la API.
EXPO_PUBLIC_MOBILE_CLIENT_KEY=
