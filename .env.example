# ─────────────── Servicio `app` (API + SPA) ───────────────
NODE_ENV=development
# 8081 en desarrollo. En producción lo fija el Dockerfile (8080) y Coolify
# mapea ese puerto — ver docs/DEPLOY.md.
PORT=8081
HOST=0.0.0.0

# Base de datos
MONGODB_URI=mongodb://localhost:27017/luma

# JWT — o JWT_SECRET (HS256) o el par de PEMs (RS256). Sin ninguno, la API no arranca.
JWT_SECRET=cambiame-por-algo-largo-y-aleatorio
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=90d

# URLs. APP_URL incluye el subpath donde se monta la SPA: en producción es /app.
FRONTEND_URL=http://localhost:6173
APP_URL=http://localhost:6173
ALLOWED_ORIGINS=http://localhost:6173
LANDING_URL=http://landing:8080

# reCAPTCHA v3 — obligatorio en producción, opcional en desarrollo.
RECAPTCHA_SECRET_KEY=
# Temporal: el front todavía no manda el token (ver docs/DEPLOY.md). En producción,
# sin esto login y registro rechazan a todos. true = el servidor no verifica.
# SKIP_RECAPTCHA=true

# Emails (Resend). Sin API key los mails quedan deshabilitados y la app sigue andando.
RESEND_API_KEY=
# Temporal: false = el registro no pide confirmar el mail (cuenta ya verificada).
# REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=onboarding@resend.dev
APP_NAME=Luma

# Consultor IA (Claude, ver packages/api/src/services/project-advisor.service.ts).
# Sin API key el feature queda deshabilitado y la app sigue andando.
ANTHROPIC_API_KEY=

# Suscripción — pago con tarjeta (Stripe Checkout). Sin la secret key no se ofrece.
# No hace falta la publishable key: el pago es en la página de Stripe.
# Los precios se crean con `pnpm --filter @luma/api stripe:setup` (por lookup_key).
STRIPE_SECRET_KEY=
# El "Signing secret" del webhook (dashboard) o el que imprime `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Suscripción — pago en bolívares (aprobación manual de un admin).
# Cada método se ofrece sólo si tiene todos sus datos; sin ninguno, no se ofrece pago en Bs.
# La tasa sale del BCV (tarea programada, ver docs/DEPLOY.md); BCV_URL es opcional.
# PAGO_MOVIL_BANK=Banesco
# PAGO_MOVIL_PHONE=0414-0000000
# PAGO_MOVIL_ID=J-00000000-0
# TRANSFER_BANK=Banco de Venezuela
# TRANSFER_ACCOUNT=0102-0000-00-0000000000
# TRANSFER_HOLDER=Luma C.A.
# TRANSFER_ID=J-00000000-0

# Primer admin, para `pnpm seed:admin`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiame
ADMIN_NAME=Admin

# ─────────────── Build args (se hornean en el bundle) ───────────────
# Servicio `app`:
VITE_RECAPTCHA_SITE_KEY=
# Servicio `landing`:
VITE_APP_URL=http://localhost:6173

# Storage de archivos (media-service). Sin estas dos, subir evidencia/documentos da 503.
MEDIA_SERVICE_URL=https://media.matflow.site
MEDIA_SERVICE_API_KEY=
