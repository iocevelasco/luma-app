# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/luma
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Auth — HS256 con JWT_SECRET, o RS256 con el par PEM
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=90d

# Email (opcional — sin key los mails se loguean por consola)
RESEND_API_KEY=
EMAIL_FROM=Luma <no-reply@luma.app>
APP_NAME=Luma

# Asistente conversacional RF-06 (opcional — sin key el chat responde 503)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ASSISTANT_DAILY_LIMIT=200

# Feature flags
ENABLE_SCHEDULERS=true

# ─── Web ──────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
