# Copiar a /etc/luma/mongo-backup.env en el VPS (chmod 600).
MONGO_CONTAINER=<id-del-contenedor-de-mongo>
MONGO_URI=mongodb://luma:LA_PASSWORD@localhost:27017/?authSource=admin

# Copia local: protege del error humano, no de perder el servidor.
LOCAL_DIR=/var/backups/luma
RETENTION_DAYS=14

# Offsite. Vacío = sólo copia local. Ver `rclone config` para crear el remoto.
RCLONE_REMOTE=
